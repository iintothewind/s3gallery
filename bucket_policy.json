{
  "Version": "2012-10-17",
  "Id": "PolicyForDestinationBucket",
  "Statement": [
    {
      "Sid": "PublicReadAppShell",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::<BUCKET_NAME>/<APP_PREFIX>/*"
      ]
    },
    {
      "Sid": "PublicListGalleryPrefix",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "<GALLERY_ROOT_PREFIX>/",
            "<GALLERY_ROOT_PREFIX>/*"
          ]
        }
      }
    },
    {
      "Sid": "PublicReadGalleryObjects",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<BUCKET_NAME>/<GALLERY_ROOT_PREFIX>/*"
    }
  ]
}
